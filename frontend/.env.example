# Copy to .env.local. Never commit real values.

# Where the Flask API is reachable from the browser. Leave empty to use the same origin
# (the dev/preview servers proxy /api to FUNDBRIDGE_BACKEND_URL below).
# When set to another origin, the backend must list this site in FRONTEND_ORIGIN (CORS).
VITE_API_BASE_URL=

# Dev/preview proxy target for /api (not exposed to the browser bundle).
FUNDBRIDGE_BACKEND_URL=http://127.0.0.1:5000
