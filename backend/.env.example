FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=postgresql+psycopg://fundbridge:fundbridge@localhost/fundbridge
FRONTEND_ORIGIN=http://localhost:3000
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYOUT_PROVIDER=simulator
# DEMO_MODE never marks a payout as succeeded; it only acknowledges submission.
DEMO_MODE=true

# ---------------------------------------------------------------- AI (OpenAI via provider abstraction)
# auto = use OpenAI when OPENAI_API_KEY is set, otherwise deterministic fallbacks; disabled = never call AI.
AI_PROVIDER=auto
OPENAI_API_KEY=
# Model decision and verification: docs/integration/openai.md. Default gpt-5.4-mini (unverified from this repo).
# After setting the key run: flask --app run:app fundbridge-ai check
OPENAI_MODEL=gpt-5.4-mini
# Sent to reasoning models only (default "low"); "omit" sends nothing (use for gpt-4.x models).
OPENAI_REASONING_EFFORT=
# Extra max_completion_tokens for hidden reasoning when an effort is sent.
OPENAI_REASONING_TOKEN_ALLOWANCE=1024
OPENAI_BASE_URL=
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=1
AI_RATE_LIMIT_PER_MINUTE=10
AI_PUBLIC_RATE_LIMIT_PER_MINUTE=20

# ---------------------------------------------------------------- SMS / USSD
# simulator (default, nothing leaves the server) | africastalking
SMS_PROVIDER=simulator
# AT_USERNAME=sandbox only reaches Africa's Talking's simulator, not real phones.
AT_USERNAME=
AT_API_KEY=
# For two-way SMS this is your shortcode. Setup and testing: docs/integration/africastalking.md
AT_SENDER_ID=
# Only for an egress proxy or a test double; normally derived from AT_USERNAME (sandbox vs live host).
AT_API_BASE_URL=
# Shared secret required on /api/v1/messaging/ussd and /sms/inbound (?token=...). Callbacks fail closed when empty.
MESSAGING_CALLBACK_TOKEN=
# Optional comma-separated CIDRs allowed to call the gateway callbacks.
MESSAGING_ALLOWED_IPS=
USSD_SERVICE_CODE=*384*123#
MESSAGING_DEFAULT_COUNTRY=KE
PUBLIC_BASE_URL=http://localhost:3000
MESSAGING_NOTIFICATIONS_ENABLED=true
MESSAGING_SMS_ASSISTANT_ENABLED=true
# Demo only: exposes /api/v1/messaging/simulator. Never enable with real beneficiary data.
MESSAGING_SIMULATOR_ENABLED=false
# Number of reverse-proxy hops to trust for X-Forwarded-For (0 = not behind a proxy).
TRUSTED_PROXY_HOPS=0

# ---------------------------------------------------------------- Sign-in and order throttling (per process)
# Per-IP sign-in attempts per minute; failed sign-ins per account inside the window lock that account temporarily.
AUTH_LOGIN_LIMIT_PER_IP_PER_MINUTE=30
AUTH_LOGIN_FAILURES_PER_ACCOUNT=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
AUTH_REGISTER_LIMIT_PER_IP_PER_10_MINUTES=20
DONATION_ORDER_LIMIT_PER_IP_PER_MINUTE=30
RATE_LIMITS_ENABLED=true

# ---------------------------------------------------------------- First admin (operator bootstrap)
# Only while running: flask --app run:app fundbridge-admin create-admin --email you@example.org
# Prefer the interactive prompt. Never leave this set in a deployed environment.
# FUNDBRIDGE_ADMIN_PASSWORD=
